# GoFeedMe - Environment Variables

# Copy this file as .env.local and fill in with your real value

# PostgreSQL Database
# Get this URL from your database provider (Vercel, Neon, Railway, etc.)
# Format: postgresql://user:password@host:port/database?sslmode=require
POSTGRES_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Slack Bot Integration (optional)
# Create a Slack App at https://api.slack.com/apps
# See SLACK_SETUP.md for step-by-step instructions
SLACK_BOT_TOKEN="xoxb-your-bot-token"
SLACK_SIGNING_SECRET="your-signing-secret"

