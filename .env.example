# GoFeedMe - Environment Variables

# Copy this file as .env.local and fill in with your real value

# PostgreSQL Database
# Get this URL from your database provider (Vercel, Neon, Railway, etc.)
# Format: postgresql://user:password@host:port/database?sslmode=require
POSTGRES_URL="postgresql://user:password@host:5432/database?sslmode=require"

